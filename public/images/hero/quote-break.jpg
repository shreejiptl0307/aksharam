<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 2400 1350" width="2400" height="1350">
  <!-- Flat Minimal Neutral Studio Background -->
  <rect width="100%" height="100%" fill="#ECEBE7" />
  
  <!-- Subtle Framing Line -->
  <rect x="24" y="24" width="2352" height="1302" fill="none" stroke="#DCDAD4" stroke-width="1" />

  <!-- Clean Editorial Typography -->
  <g transform="translate(1200, 675)">
    <text y="-8" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="28" fill="#171717" text-anchor="middle" font-weight="500" letter-spacing="3">
      EDITORIAL CAMPAIGN
    </text>
    <text y="24" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="14" fill="#73706B" text-anchor="middle" font-weight="400" letter-spacing="2">
      Full-bleed Photography
    </text>
  </g>

  <!-- Technical Spec Footer -->
  <text x="44" y="1310" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" fill="#73706B" font-weight="400" letter-spacing="1.5">
    AKSHARAM ETHNIC LLP
  </text>
  <text x="2356" y="1310" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="11" fill="#73706B" text-anchor="end" font-weight="400" letter-spacing="1">
    2400 × 1350px [PHOTOGRAPHY PLACEHOLDER]
  </text>
</svg>